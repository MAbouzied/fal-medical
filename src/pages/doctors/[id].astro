---
import DoctorCard from '../../components/doctors/DoctorCard.astro';
import DoctorDetailContent from '../../components/doctors/DoctorDetailContent.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import BookingSection from '../../components/services/BookingSection.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { doctors, getDoctorById } from '../../data/doctors';
import { faqItems } from '../../data/faq';
import {
  buildBreadcrumbSchema,
  buildPhysicianSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return doctors.map((doctor) => ({
    params: { id: doctor.id },
  }));
}

const { id } = Astro.params;
const doctor = getDoctorById(id ?? '');

if (!doctor) {
  return Astro.redirect('/doctors');
}

const site = Astro.site!;
const doctorPath = `/doctors/${doctor.id}`;
const mainEntityId = `${new URL(doctorPath, site).href}#physician`;
const title = `${doctor.name} — ${doctor.seoRole} | فال`;
const description = doctor.summary;
const relatedDoctors = doctors
  .filter((item) => item.specialty === doctor.specialty && item.id !== doctor.id)
  .slice(0, 3);
---

<Layout
  title={title}
  description={description}
  ogType="profile"
  schemas={[
    buildWebPageSchema({
      site,
      path: doctorPath,
      name: title,
      description,
      type: 'ProfilePage',
      mainEntityId,
    }),
    buildBreadcrumbSchema(site, [
      { name: 'الرئيسية', path: '/' },
      { name: 'الأطباء', path: '/doctors' },
      { name: doctor.name, path: doctorPath },
    ]),
    buildPhysicianSchema(site, doctor),
  ]}
>
  <Breadcrumbs
    items={[
      { name: 'الرئيسية', href: '/' },
      { name: 'الأطباء', href: '/doctors' },
      { name: doctor.name },
    ]}
  />
  <DoctorDetailContent doctor={doctor} />

  <BookingSection />

  {relatedDoctors.length > 0 && (
    <section class="py-14 sm:py-24" aria-labelledby="related-doctors-heading">
      <div class="page-container">
        <div id="related-doctors-heading">
          <SectionHeading eyebrow="أطباء آخرون" title="من نفس التخصص" />
        </div>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          {relatedDoctors.map((relatedDoctor) => <DoctorCard doctor={relatedDoctor} />)}
        </div>
      </div>
    </section>
  )}

  <FaqSection items={faqItems} />
</Layout>
