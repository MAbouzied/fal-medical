---
import { clinicFacts } from '../data/clinic-facts';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import ServicesPage from '../components/services/ServicesPage.astro';
import { clinicServices } from '../data/services';
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  itemListId,
} from '../lib/schema';
import Layout from '../layouts/Layout.astro';

const site = Astro.site!;
const title = `خدمات الأسنان والجلدية في ${clinicFacts.cityAr} | فال`;
const description =
  `تصفح خدمات طب الأسنان والجلدية في عيادة فال ب${clinicFacts.cityAr} واحجز موعدك مع فريق متخصص.`;
const listId = itemListId(site, '/services');
---

<Layout
  title={title}
  description={description}
  schemas={[
    buildWebPageSchema({
      site,
      path: '/services',
      name: title,
      description,
      type: 'CollectionPage',
      mainEntityId: listId,
    }),
    buildBreadcrumbSchema(site, [
      { name: 'الرئيسية', path: '/' },
      { name: 'الخدمات', path: '/services' },
    ]),
    buildItemListSchema({
      site,
      path: '/services',
      name: 'خدمات فال',
      description,
      itemType: 'Service',
      items: clinicServices.map((service) => ({
        name: service.title,
        path: `/services/${service.id}`,
        description: service.description,
        image: service.heroImage,
      })),
    }),
  ]}
>
  <Breadcrumbs
    items={[
      { name: 'الرئيسية', href: '/' },
      { name: 'الخدمات' },
    ]}
  />
  <ServicesPage />
</Layout>
