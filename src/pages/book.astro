---
import { clinicFacts, formatClinicLocation } from '../data/clinic-facts';
import ClinicLineButtons from '../components/contact/ClinicLineButtons.astro';
import ClinicPhoneList from '../components/contact/ClinicPhoneList.astro';
import AssetIcon from '../components/ui/AssetIcon.astro';
import BookingServiceFields from '../components/contact/BookingServiceFields.astro';
import { organization } from '../data/organization';
import { buildWebPageSchema } from '../lib/schema';
import Layout from '../layouts/Layout.astro';

const contactMessage = 'مرحباً، أود الاستفسار عن خدمات فال.';
const site = Astro.site!;
const title = `احجز موعدك في عيادة فال ب${clinicFacts.cityAr}`;
const description =
  `احجز موعدك في فال ب${clinicFacts.cityAr} خلال دقائق — أدخل اسمك ورقم جوالك واختر التخصص والخدمة.`;
const fieldClass =
  'min-h-12 w-full rounded-2xl border border-border bg-surface px-4 text-sm text-ink shadow-[var(--shadow-control)] placeholder:text-placeholder focus:border-primary aria-[invalid=true]:border-danger';
---

<Layout
  title={title}
  description={description}
  noindex={false}
  schemas={[
    buildWebPageSchema({ site, path: '/book', name: title, description }),
  ]}
>
  <section class="relative overflow-hidden border-b border-border bg-gradient-to-bl from-surface-accent via-surface to-surface-soft py-10 sm:py-16">
    <div class="page-container mx-auto max-w-xl">
      <div class="mb-8 text-center">
        <img src="/assets/logo.png" alt="" width="56" height="56" class="mx-auto size-14 object-contain" />
        <p class="mt-4 text-sm font-bold text-primary">{organization.name}</p>
        <h1 class="text-display mt-3 font-black text-ink">احجز موعدك الآن</h1>
        <p class="mt-3 text-sm leading-7 text-muted">
          فرع {clinicFacts.cityAr} — {formatClinicLocation('ar')}
        </p>
      </div>

      <form
        class="rounded-[2rem] border border-border bg-surface p-5 shadow-[var(--shadow-card)] sm:p-8"
        method="post"
        action="/api/customers"
        data-astro-reload
        data-lead-form
        data-gtm-form="lead_quick"
        novalidate
      >
        <label class="sr-only" aria-hidden="true">
          Website
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <div class="grid gap-4">
          <label class="grid gap-2 text-xs font-bold">
            الاسم
            <input id="lead-name" name="name" type="text" required minlength="3" maxlength="100" autocomplete="name" placeholder="اسمك الكامل" class={fieldClass} aria-describedby="lead-name-error" aria-invalid="false" />
            <p id="lead-name-error" class="hidden text-xs text-danger" role="status" data-error-for="lead-name"></p>
          </label>
          <label class="grid gap-2 text-xs font-bold">
            رقم الجوال
            <input id="lead-phone" name="phone" type="tel" dir="ltr" required minlength="10" maxlength="20" pattern="05[0-9]{8}" inputmode="numeric" autocomplete="tel" placeholder="05XXXXXXXX" class={fieldClass} aria-describedby="lead-phone-error" aria-invalid="false" />
            <p id="lead-phone-error" class="hidden text-xs text-danger" role="status" data-error-for="lead-phone"></p>
          </label>
          <BookingServiceFields
            fieldClass={fieldClass}
            labelClass="grid gap-2 text-xs font-bold"
            specialtyLabel="التخصص"
            serviceLabel="الخدمة المطلوبة"
            specialtyPlaceholder="اختر التخصص"
            servicePlaceholder="اختر الخدمة"
            specialtyId="lead-department"
            serviceId="lead-service"
            specialtyDescribedBy="lead-department-error"
            serviceDescribedBy="lead-service-error"
          >
            <p slot="specialty-error" id="lead-department-error" class="hidden text-xs text-danger" role="status" data-error-for="lead-department"></p>
            <p slot="service-error" id="lead-service-error" class="hidden text-xs text-danger" role="status" data-error-for="lead-service"></p>
          </BookingServiceFields>
        </div>

        <label class="mt-5 flex items-start gap-3 text-xs leading-6 text-muted">
          <input id="lead-consent" name="consent" type="checkbox" required class="mt-1 size-4 shrink-0 accent-primary" aria-describedby="lead-consent-error" aria-invalid="false" />
          <span>
            أوافق على
            {' '}
            <a href="/privacy" class="font-bold text-primary underline-offset-2 hover:underline">سياسة الخصوصية</a>
            {' '}
            وحفظ بيانات الحجز والتواصل معي لتأكيد الموعد.
          </span>
        </label>
        <p id="lead-consent-error" class="mt-1 hidden text-xs text-danger" role="status" data-error-for="lead-consent"></p>

        <button
          type="submit"
          class="mt-6 inline-flex min-h-[3.25rem] w-full items-center justify-center gap-2 rounded-full bg-gold-gradient px-7 text-sm font-bold text-ink-button shadow-[var(--shadow-gold)] transition-transform hover:-translate-y-0.5"
        >
          إرسال عبر واتساب
          <AssetIcon src="/assets/whatsapp.svg" size="sm" />
        </button>
        <p class="mt-3 min-h-5 text-center text-sm font-medium" role="status" aria-live="polite" data-lead-status></p>
      </form>

      <div class="mt-6" data-gtm-location="lead_quick">
        <ClinicLineButtons
          mode="both"
          whatsappMessage={contactMessage}
          callLabel="اتصال مباشر"
          whatsappLabel="تواصل عبر واتساب"
        />
      </div>

      <div class="mt-6 text-center text-xs text-muted">
        <ClinicPhoneList class="inline-flex flex-col items-center space-y-1" />
      </div>
    </div>
  </section>
</Layout>

<script>
  import {
    buildBookingWhatsAppMessage,
    buildWhatsAppUrl,
    clinicContact,
    clinicLineFromDepartment,
  } from '../data/contact';
  import { saveCustomerLead } from '../lib/customer-leads';
  import { GtmEvents, pushGtmEvent } from '../lib/gtm';

  const bindLeadForm = () => {
    const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector<HTMLElement>('[data-lead-status]');
    const formId = form.dataset.gtmForm ?? 'lead_quick';
    const requiredFields = [
      ...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required], select[required]'),
    ];
    const messages: Readonly<Record<string, string>> = {
      'lead-name': 'يرجى إدخال الاسم الكامل (3 أحرف على الأقل).',
      'lead-phone': 'يرجى إدخال رقم جوال سعودي بصيغة 05XXXXXXXX.',
      'lead-department': 'يرجى اختيار التخصص.',
      'lead-service': 'يرجى اختيار الخدمة.',
      'lead-consent': 'الموافقة مطلوبة للمتابعة.',
    };
    const showFieldState = (field: HTMLInputElement | HTMLSelectElement) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      const isValid = field.checkValidity();
      field.setAttribute('aria-invalid', String(!isValid));
      if (error) {
        error.textContent = isValid ? '' : messages[field.id] ?? '';
        error.classList.toggle('hidden', isValid);
      }
      return isValid;
    };
    requiredFields.forEach((field) => {
      field.addEventListener('blur', () => showFieldState(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') showFieldState(field);
      });
      field.addEventListener('change', () => {
        if (field.getAttribute('aria-invalid') === 'true') showFieldState(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const isValid = requiredFields.every(showFieldState);
      if (!isValid) {
        pushGtmEvent(GtmEvents.formError, { form_id: formId, method: 'whatsapp' });
        if (status) {
          status.textContent = 'يرجى تعبئة الاسم ورقم الجوال والتخصص والخدمة.';
          status.className = 'mt-3 min-h-5 text-center text-sm font-medium text-danger';
        }
        requiredFields.find((field) => !field.checkValidity())?.focus();
        return;
      }

      const data = new FormData(form);
      const department = String(data.get('department') ?? '').trim();
      const service = String(data.get('service') ?? '').trim();
      const message = buildBookingWhatsAppMessage({
        name: String(data.get('name') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
        department,
        service,
        branch: clinicContact.branch,
      });
      const whatsappUrl = buildWhatsAppUrl(message, clinicLineFromDepartment(service || department));

      pushGtmEvent(GtmEvents.formSubmit, {
        form_id: formId,
        method: 'whatsapp',
      });

      void (async () => {
        const result = await saveCustomerLead({
          name: String(data.get('name') ?? '').trim(),
          phone: String(data.get('phone') ?? '').trim(),
          department,
          service,
          locale: 'ar',
          consent: data.has('consent'),
          website: String(data.get('website') ?? ''),
        });

        if (status) {
          status.textContent = result.ok
            ? 'جارٍ فتح واتساب...'
            : 'تعذر حفظ السجل الإلكتروني. سيتم فتح واتساب لإرسال الطلب للعيادة.';
          status.className = result.ok
            ? 'mt-3 min-h-5 text-center text-sm font-medium text-success'
            : 'mt-3 min-h-5 text-center text-sm font-medium text-danger';
        }

        window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
      })();
    });
  };

  document.addEventListener('astro:page-load', bindLeadForm);
</script>
