---
import LandingHero from '../../components/landing/LandingHero.astro';
import LandingSections from '../../components/landing/LandingSections.astro';
import { clinicFacts, formatClinicDescription } from '../../data/clinic-facts';
import { resolveLandingPage } from '../../data/landing';
import { localizeFaq } from '../../lib/i18n/localize';
import {
  buildFaqSchema,
  buildItemListSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import Layout from '../../layouts/Layout.astro';

const site = Astro.site!;
const landing = resolveLandingPage('en');
const title = `Fal Clinic in ${clinicFacts.cityEn} | Multi-specialty medical complex`;
const description = `${formatClinicDescription('en')} Book via the site or WhatsApp.`;
const faqItems = localizeFaq('en');
---

<Layout
  title={title}
  description={description}
  locale="en"
  schemas={[
    buildWebPageSchema({
      site,
      path: '/en',
      name: title,
      description,
      locale: 'en',
    }),
    buildItemListSchema({
      site,
      path: '/en',
      name: landing.specialties.title,
      description: landing.specialties.intro,
      locale: 'en',
      itemType: 'Service',
      items: landing.specialties.items.map((item) => ({
        name: item.title,
        path: item.href,
        description: item.text,
        image: item.imageSrc,
      })),
    }),
    buildFaqSchema(faqItems),
  ]}
>
  <LandingHero locale="en" />
  <LandingSections locale="en" />
</Layout>
