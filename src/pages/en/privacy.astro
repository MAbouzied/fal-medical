---
import { clinicFacts } from '../../data/clinic-facts';
import {
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import Layout from '../../layouts/Layout.astro';

const site = Astro.site!;
const title = 'Privacy Policy | Fal Clinic';
const description =
  `Learn how Fal Clinic in ${clinicFacts.cityEn} collects, uses, and protects your information when you contact us or book online.`;
---

<Layout
  title={title}
  description={description}
  locale="en"
  schemas={[
    buildWebPageSchema({
      site,
      path: '/en/privacy',
      name: title,
      description,
      locale: 'en',
    }),
    buildBreadcrumbSchema(site, [
      { name: 'Home', path: '/en' },
      { name: 'Privacy Policy', path: '/en/privacy' },
    ]),
  ]}
>
  <section class="py-14 sm:py-24">
    <div class="page-container mx-auto max-w-3xl">
      <h1 class="text-display font-black text-ink">Privacy Policy</h1>
      <p class="mt-4 text-sm leading-7 text-muted sm:text-base">
        This policy explains how Fal Clinic handles information you submit through the website when requesting an appointment or contacting the clinic.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Information we collect</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        We may collect your name, mobile number, department, requested service, and any notes you send through booking forms or WhatsApp, plus basic technical data needed to run the site securely.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">How we use information</h2>
      <ul class="mt-3 list-disc space-y-2 ps-5 text-sm leading-7 text-muted sm:text-base">
        <li>To confirm appointments and respond to inquiries.</li>
        <li>To organize booking requests inside the clinic.</li>
        <li>To improve the website experience and service quality.</li>
      </ul>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Sharing</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        We do not sell your data. Information may be shared with essential operational tools such as WhatsApp or internal clinic follow-up systems, only as needed to provide the service.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Analytics cookies</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        We load Google Tag Manager / Google Analytics only after you explicitly accept the site consent banner. Name, phone, department, and service details are never sent to analytics. You can reject analytics and remain tracking-free.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Booking records</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        Booking requests are stored in the clinic’s Google Sheets for internal follow-up and then transferred over WhatsApp to confirm the appointment. To review, correct, or delete a record, contact us using the email below. We keep booking records only as long as needed for clinic operations and applicable requirements, then delete or anonymize them.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Staff Google sign-in</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        When staff use the clinic admin login, we process Google profile name, email, and profile image only to verify identity. We request openid, email, and profile scopes without offline access. An encrypted session cookie lasts about eight hours, access is limited to pre-approved emails, and staff can end the session with sign-out.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Your rights</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        You may request a correction or ask how your data is used by emailing
        {' '}
        <a class="font-bold text-primary hover:underline" href="mailto:info@falclinic.com">info@falclinic.com</a>
        {' '}
        or contacting the clinic on WhatsApp.
      </p>

      <h2 class="mt-10 text-xl font-extrabold text-ink">Contact</h2>
      <p class="mt-3 text-sm leading-7 text-muted sm:text-base">
        For privacy questions, use our
        {' '}
        <a class="font-bold text-primary hover:underline" href="/en/contact">contact page</a>
        {' '}
        or the clinic phone number shown on the website.
      </p>
    </div>
  </section>
</Layout>
