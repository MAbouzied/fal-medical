---
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import ServicesPage from '../../../components/services/ServicesPage.astro';
import { clinicServices } from '../../../data/services';
import { localizeService, ui } from '../../../lib/i18n/localize';
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  itemListId,
} from '../../../lib/schema';
import Layout from '../../../layouts/Layout.astro';

const site = Astro.site!;
const copy = ui('en')!;
const title = copy.pages.servicesTitle;
const description = copy.pages.servicesDescription;
const localizedServices = clinicServices.map((service) => localizeService(service, 'en'));
const listId = itemListId(site, '/en/services');
---

<Layout
  title={title}
  description={description}
  locale="en"
  schemas={[
    buildWebPageSchema({
      site,
      path: '/en/services',
      name: title,
      description,
      type: 'CollectionPage',
      locale: 'en',
      mainEntityId: listId,
    }),
    buildBreadcrumbSchema(site, [
      { name: copy.nav.home, path: '/en' },
      { name: copy.nav.services, path: '/en/services' },
    ]),
    buildItemListSchema({
      site,
      path: '/en/services',
      name: 'Fal Clinic services',
      description,
      locale: 'en',
      itemType: 'Service',
      items: localizedServices.map((service) => ({
        name: service.title,
        path: `/en/services/${service.id}`,
        description: service.description,
        image: service.heroImage,
      })),
    }),
  ]}
>
  <Breadcrumbs
    locale="en"
    items={[
      { name: 'Home', href: '/en' },
      { name: 'Services' },
    ]}
  />
  <ServicesPage locale="en" />
</Layout>
