---
import {
  SANITY_ARTICLE_WIDTHS,
  SANITY_CARD_WIDTHS,
  buildSanitySrcSet,
  isExactSanityCdnUrl,
  sanitySrcForWidth,
} from '../../../lib/sanity-srcset';

export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  focalPoint?: { x: number; y: number };
  /** Use narrower card widths for listing thumbnails. */
  variant?: 'card' | 'article';
}

const {
  src,
  alt,
  width,
  height,
  caption,
  loading = 'lazy',
  class: className = '',
  focalPoint,
  variant = 'article',
} = Astro.props;

const objectPosition =
  focalPoint &&
  Number.isFinite(focalPoint.x) &&
  Number.isFinite(focalPoint.y)
    ? `${Math.min(100, Math.max(0, focalPoint.x * 100)).toFixed(2)}% ${Math.min(
        100,
        Math.max(0, focalPoint.y * 100),
      ).toFixed(2)}%`
    : undefined;

const widths = variant === 'card' ? SANITY_CARD_WIDTHS : SANITY_ARTICLE_WIDTHS;
const srcset = buildSanitySrcSet(src, widths);
const sizes =
  variant === 'card'
    ? '(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) 50vw, 360px'
    : '(max-width: 768px) calc(100vw - 2rem), 720px';
const optimizedSrc = isExactSanityCdnUrl(src)
  ? sanitySrcForWidth(src, Math.min(width, widths[widths.length - 1] ?? width))
  : src;
---

<figure class:list={['blog-image', className]}>
  <img
    src={optimizedSrc}
    alt={alt}
    width={width}
    height={height}
    sizes={srcset ? sizes : undefined}
    srcset={srcset}
    loading={loading}
    decoding="async"
    style={objectPosition ? `--blog-object-position: ${objectPosition}` : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
