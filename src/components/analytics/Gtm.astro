---
import { isGtmConfigured } from '../../lib/gtm';
---

{isGtmConfigured && (
  <script>
    import {
      GTM_ID,
      GtmEvents,
      isGtmEnabled,
      loadGtmContainer,
      pushGtmEvent,
      resolveContactEvent,
      resolveCtaLocation,
    } from '../../lib/gtm';

    const load = () => {
      if (!isGtmEnabled()) return;
      loadGtmContainer(GTM_ID);
    };

    const idle = (
      window as Window & {
        requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
      }
    ).requestIdleCallback;
    if (typeof idle === 'function') {
      idle(load, { timeout: 2_000 });
    } else {
      globalThis.setTimeout(load, 1);
    }

    const bindContactTracking = () => {
      if (document.documentElement.dataset.gtmContactBound === 'true') return;
      document.documentElement.dataset.gtmContactBound = 'true';

      document.addEventListener(
        'click',
        (event) => {
          if (!isGtmEnabled()) return;
          const target = event.target;
          if (!(target instanceof Element)) return;

          const link = target.closest('a[href]');
          if (!(link instanceof HTMLAnchorElement)) return;

          const eventName = resolveContactEvent(link.href);
          if (!eventName) return;

          pushGtmEvent(eventName, {
            link_url: link.href,
            link_text: (link.textContent || '').trim().slice(0, 80),
            cta_location: resolveCtaLocation(link),
            contact_method:
              eventName === GtmEvents.contactWhatsapp
                ? 'whatsapp'
                : eventName === GtmEvents.contactCall
                  ? 'call'
                  : 'email',
          });
        },
        true,
      );
    };

    bindContactTracking();

    // astro:after-swap fires only on SPA navigations (View Transitions), not on
    // the initial page load. gtag config / GTM gtm.js handles the first page_view
    // when the script is loaded, avoiding a double send on first load.
    document.addEventListener('astro:after-swap', () => {
      if (!isGtmEnabled()) return;
      pushGtmEvent('page_view', {
        page_title: document.title,
        page_location: window.location.href,
      });
    });
  </script>
)}
