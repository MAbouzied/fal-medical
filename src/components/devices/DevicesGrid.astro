---
import { localizeDevices } from '../../lib/i18n/localize';
import type { Locale } from '../../lib/i18n/localize';
import { isEnglish, ui } from '../../lib/i18n/localize';
import SectionHeading from '../ui/SectionHeading.astro';
import SitePicture from '../ui/SitePicture.astro';

export interface Props {
  locale?: Locale;
  headingLevel?: 1 | 2;
}

const { locale = 'ar', headingLevel = 2 } = Astro.props;
const en = isEnglish(locale);
const copy = ui(locale);
const devices = localizeDevices(locale);

const heading = en
  ? {
      eyebrow: copy!.home.devicesEyebrow,
      title: copy!.pages.devicesHeading,
      description: copy!.home.devicesSectionText,
    }
  : {
      eyebrow: 'أجهزتنا',
      title: 'التقنية داخل العيادة',
      description: 'تعرّف على الأجهزة المستخدمة في مجمع عيادات فال لرعاية أدق وأكثر راحة.',
    };

function deviceHeading(name: string): { prefix: string | null; title: string } {
  const match = name.match(/^(جهاز)\s+(.+)$/);
  return match ? { prefix: match[1], title: match[2] } : { prefix: null, title: name };
}
---

<section id="clinic-devices" class="scroll-mt-24 bg-surface py-12 sm:py-24" aria-labelledby="devices-heading">
  <div class="page-container">
    <div id="devices-heading">
      <SectionHeading
        eyebrow={heading.eyebrow}
        title={heading.title}
        description={heading.description}
        level={headingLevel}
      />
    </div>
    <ul class="mt-10 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {devices.map((device) => {
        const headingParts = deviceHeading(device.name);
        return (
        <li>
          <article class="flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface shadow-[var(--shadow-card)]">
            <div class="aspect-[4/3] overflow-hidden bg-surface-accent">
              <SitePicture
                src={device.image}
                alt={device.imageAlt}
                widths={[320, 480, 640, 800]}
                sizes="(max-width: 768px) calc(100vw - 2rem), 30vw"
                class="size-full object-contain"
              />
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5 sm:p-6">
              <h3 class="text-base font-bold tracking-tight text-balance text-ink sm:text-lg">
                {headingParts.prefix ? (
                  <>
                    {headingParts.prefix} <span dir="ltr">{headingParts.title}</span>
                  </>
                ) : (
                  device.name
                )}
              </h3>
              <p class="text-sm leading-6 text-pretty text-muted">{device.description}</p>
            </div>
          </article>
        </li>
        );
      })}
    </ul>
  </div>
</section>
