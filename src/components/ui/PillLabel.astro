---
export interface Props {
  text: string;
  showDot?: boolean;
}

const { text, showDot = false } = Astro.props;
---

<span class="inline-flex max-w-full items-center justify-center gap-1.5 rounded-full border border-success/50 bg-surface-accent px-3 py-1 text-center text-[0.6875rem] leading-[14px] font-bold tracking-[0.05em] text-balance text-gold-text uppercase">
  {text}
  {showDot && <span class="size-1.5 shrink-0 rounded-full bg-success" aria-hidden="true"></span>}
</span>
