---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveSiteImage } from '../../lib/site-images';

export interface Props {
  /** Public path key (e.g. `/assets/landing-hero.jpg`) or imported metadata. */
  src: string | ImageMetadata;
  alt: string;
  widths?: number[];
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'auto' | 'sync';
}

const {
  src,
  alt,
  widths = [480, 768, 960, 1280],
  sizes,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
} = Astro.props;

const image = typeof src === 'string' ? resolveSiteImage(src) : src;
if (!image) {
  throw new Error(`Unknown site image: ${String(src)}`);
}
---

<Picture
  src={image}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
/>
