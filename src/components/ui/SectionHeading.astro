---
import PillLabel from './PillLabel.astro';

export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  level?: 1 | 2;
}

const { eyebrow, title, description, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<div class="mx-auto flex max-w-3xl flex-col items-center gap-3 text-center">
  <PillLabel text={eyebrow} />
  <Heading class="text-display font-black text-ink">
    {title}
  </Heading>
  {description && (
    <p class="max-w-3xl text-sm leading-6 text-pretty text-muted sm:text-lg lg:text-xl lg:leading-8">
      {description}
    </p>
  )}
</div>
