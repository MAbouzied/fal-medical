---
import { resolveLandingPage } from '../../data/landing';
import type { Locale } from '../../lib/i18n/localize';
import PillLabel from '../ui/PillLabel.astro';
import SitePicture from '../ui/SitePicture.astro';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const page = resolveLandingPage(locale);
---

<section id="services" class="scroll-mt-24 bg-surface py-12 sm:py-24" aria-labelledby="specialties-heading">
  <div class="page-container">
    <div class="mx-auto flex max-w-[38.75rem] flex-col items-center gap-3 text-center">
      <PillLabel text={page.specialties.eyebrow} />
      <h2 id="specialties-heading" class="text-display font-black text-ink">{page.specialties.title}</h2>
      <p class="text-[1.0625rem] leading-[1.7] text-pretty text-muted">{page.specialties.intro}</p>
    </div>

    <ul class="mt-10 grid list-none gap-6 p-0 md:grid-cols-3">
      {page.specialties.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="group flex min-h-[27.375rem] flex-col overflow-hidden rounded-[var(--radius-card)] bg-footer no-underline transition hover:-translate-y-0.5"
          >
            <div class="specialty-photo relative h-[15.0625rem] shrink-0">
              <SitePicture
                src={item.imageSrc}
                alt={item.imageAlt}
                widths={[360, 540, 720]}
                sizes="(max-width: 768px) calc(100vw - 2rem), 30vw"
                class="size-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-footer via-footer/40 to-footer/10"></div>
            </div>
            <div class="flex flex-1 flex-col items-start justify-end gap-2 px-7 pb-7 pt-4">
              <h3 class="text-[1.625rem] leading-tight font-black text-on-dark">{item.title}</h3>
              <p class="text-sm leading-6 text-on-dark/80">{item.text}</p>
              <span class="mt-1 inline-flex border-b border-icon-accent/40 pb-1 text-[0.8125rem] font-bold text-icon-accent group-hover:text-on-dark">
                {page.specialties.more}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .specialty-photo :global(picture),
  .specialty-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
