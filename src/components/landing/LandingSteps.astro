---
import { resolveLandingPage } from '../../data/landing';
import type { Locale } from '../../lib/i18n/localize';
import PillLabel from '../ui/PillLabel.astro';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const page = resolveLandingPage(locale);
---

<section class="bg-surface py-12 sm:py-24" aria-labelledby="steps-heading">
  <div class="page-container">
    <div class="mx-auto flex max-w-[38.75rem] flex-col items-center gap-3 text-center">
      <PillLabel text={page.steps.eyebrow} />
      <h2 id="steps-heading" class="text-display font-black text-ink">{page.steps.title}</h2>
      <p class="text-[1.0625rem] leading-[1.7] text-pretty text-muted">{page.steps.intro}</p>
    </div>

    <div class="relative mt-10">
      <div class="pointer-events-none absolute top-8 start-[8%] end-[8%] hidden h-px bg-border lg:block" aria-hidden="true"></div>
      <ol class="relative grid list-none gap-8 p-0 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {page.steps.items.map((step) => (
          <li class="relative flex flex-col items-start gap-2 px-2">
            <span class="grid size-16 place-items-center rounded-[2rem] border border-border bg-on-dark text-[1.625rem] font-black text-gold-text">
              {step.number}
            </span>
            <h3 class="pt-2 text-[1.0625rem] font-bold text-ink">{step.title}</h3>
            <p class="text-sm leading-[1.7] text-muted-soft">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
