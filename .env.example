# Optional: override clinic phone / WhatsApp numbers (digits only, country code, no +)
# PUBLIC_CLINIC_PHONE=966557034280
# PUBLIC_DENTAL_PHONE=966557034280
# PUBLIC_DERMATOLOGY_PHONE=966557034280

# Optional: Google Tag Manager container ID (omit or leave unset to disable GTM)
# PUBLIC_GTM_ID=GTM-ABC1234

# Blog content provider: mock (default) or sanity
# BLOG_PROVIDER=sanity

# Required only when BLOG_PROVIDER=sanity (do not fall back to mock on failure)
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_VERSION=2026-08-03
# Optional server-only read token for private datasets / drafts
# SANITY_API_TOKEN=
# SANITY_WRITE_TOKEN=  # required for dashboard writes when BLOG_PROVIDER=sanity

# Private staff authorization dataset. This token is a runtime secret with
# read/write access to the staff-auth dataset only; never expose it publicly.
# SANITY_AUTH_DATASET=staff-auth
# SANITY_AUTH_TOKEN=

# Set true for local dashboard testing without Better Auth. Keep false in production.
# ADMIN_AUTH_DISABLED=true

# Hosted Sanity Studio URL (safe to expose; used by /admin navigation)
# PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio

# Staff authentication (Better Auth + Google). Required for /login and /admin.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:4321
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google Sheets server secrets use .dev.vars locally. See .dev.vars.example and README.md.
